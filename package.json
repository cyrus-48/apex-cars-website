{
  "name": "apex-cars",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "build-only": "vite-ssg build",
    "preview": "vite preview --port 4173",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/ e2e/ tests/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:lines": "node scripts/check-file-length.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "analyze": "ANALYZE=true vite-ssg build",
    "check": "run-s check:lines lint type-check test",
    "prepare": "husky"
  },
  "dependencies": {
    "@unhead/vue": "^2.1.2",
    "@vueuse/core": "^15.0.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "pinia": "^4.0.3",
    "tailwind-merge": "^3.0.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@iconify-json/ph": "^1.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.0.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "beasties": "^0.3.5",
    "eslint": "^9.30.0",
    "eslint-plugin-vue": "^10.11.1",
    "husky": "^9.1.7",
    "jiti": "^2.4.2",
    "jsdom": "^26.0.0",
    "lint-staged": "^16.0.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.2.2",
    "vite-imagetools": "^12.0.1",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-pwa": "^2.0.0",
    "vite-ssg": "^28.3.0",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.11",
    "workbox-window": "^7.4.1"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": "prettier --write"
  }
}
